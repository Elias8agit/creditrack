              "raw": "{\n  \"nombre\": \"Cliente Duplicado\",\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"Newman2026\",\n  \"dpi\": \"4999999999999\",\n  \"fechaNacimiento\": \"1990-01-15\",\n  \"ingresoMensual\": 20000\n}",
              "options": {
