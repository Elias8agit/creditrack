    {
      "name": "3. Flujo de negocio: solicitud hasta crédito finalizado",
      "item": [
        {
          "name": "Crear solicitud (BORRADOR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{microId}},\n  \"monto\": 3000,\n  \"plazoMeses\": 3,\n  \"destino\": \"Compra de mercadería para tienda\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const esquemaSolicitud = {",
                  "  type: 'object',",
                  "  required: ['id', 'estado', 'monto', 'plazoMeses', 'cuota', 'tasaAnual', 'producto'],",
                  "  properties: {",
                  "    id: { type: 'integer' }, estado: { type: 'string' }, monto: { type: 'number' },",
                  "    plazoMeses: { type: 'integer' }, cuota: { type: 'number' }, tasaAnual: { type: 'number' }, producto: { type: 'string' }",
                  "  }",
                  "};",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Esquema de la solicitud', () => pm.response.to.have.jsonSchema(esquemaSolicitud));",
                  "const r = pm.response.json();",
                  "pm.test('Estado BORRADOR y cuota Q1,040.26', () => { pm.expect(r.estado).to.eql('BORRADOR'); pm.expect(r.cuota).to.eql(1040.26); });",
                  "pm.collectionVariables.set('appId', r.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Enviar solicitud (pre-evaluación)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{appId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{appId}}",
                "submit"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Queda EN_REVISION con recomendación PREAPROBADA (regla R5)', () => { pm.expect(r.estado).to.eql('EN_REVISION'); pm.expect(r.recomendacion).to.eql('PREAPROBADA'); });",
                  "pm.test('Registra score del buró y relación deuda/ingreso', () => { pm.expect(r.score).to.be.at.least(700); pm.expect(r.rdi).to.be.below(0.3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Bandeja del analista (EN_REVISION)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{analistaToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications?estado=EN_REVISION",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "EN_REVISION"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Esquema: arreglo de solicitudes', () => pm.response.to.have.jsonSchema({ type: 'array', items: { type: 'object', required: ['id', 'estado', 'cliente'] } }));",
                  "pm.test('Contiene la solicitud enviada', () => pm.expect(pm.response.json().map((a) => a.id)).to.include(Number(pm.collectionVariables.get('appId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Analista aprueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{analistaToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{appId}}/evaluate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{appId}}",
                "evaluate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APROBAR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Estado APROBADA', () => pm.expect(pm.response.json().estado).to.eql('APROBADA'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Administrador desembolsa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{appId}}/disburse",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{appId}}",
                "disburse"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fechaDesembolso\": \"{{fechaDesembolso}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fecha de desembolso tres meses atrás para poder pagar las tres cuotas ya vencidas",
                  "const d = new Date(); d.setUTCMonth(d.getUTCMonth() - 3);",
                  "pm.collectionVariables.set('fechaDesembolso', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Estado DESEMBOLSADA con plan de 3 cuotas', () => { pm.expect(r.estado).to.eql('DESEMBOLSADA'); pm.expect(r.planPagos).to.have.length(3); });",
                  "pm.test('Esquema del plan de pagos', () => pm.expect(r.planPagos[0]).to.include.all.keys('numero', 'fechaVencimiento', 'cuota', 'saldo', 'estado'));",
                  "pm.collectionVariables.set('planPagos', JSON.stringify(r.planPagos));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cotizar cuota 1 en su vencimiento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{analistaToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/{{appId}}/payments/quote?fechaPago={{fechaPago}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "applications",
                "{{appId}}",
